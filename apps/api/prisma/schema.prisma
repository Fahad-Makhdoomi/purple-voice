// Purple Voice — the whole data model.
//
// Tenancy: every customer-owned row carries `workspaceId`. A subscriber user
// belongs to exactly one workspace; staff (ADMIN / SUPER_ADMIN) belong to
// none and reach a workspace explicitly (see middleware/workspace.ts).
//
// Secrets (AI keys, telephony tokens, OAuth tokens, webhook secrets) are
// stored AES-256-GCM encrypted in `*Enc` columns. Nothing in this schema
// holds a plaintext credential.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (mirrored in packages/shared/src/enums.ts) ─────────────────────────

enum Role {
  SUBSCRIBER
  ADMIN
  SUPER_ADMIN
}

enum PlanCode {
  /// Free tier: what every workspace gets without a paid plan.
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum BillingProvider {
  STRIPE
  RAZORPAY
  PAYPAL
  MANUAL
}

/// Gateways subscribers can pay through. Keys live in PaymentGatewayConfig
/// (Super admin → Payment gateways).
enum PaymentGateway {
  STRIPE
  RAZORPAY
  PAYPAL
}

enum SubscriptionEventType {
  CREATED
  UPGRADED
  DOWNGRADED
  RENEWED
  CANCELED
  REACTIVATED
  PAYMENT_FAILED
  ADMIN_CHANGE
}

enum CredentialProvider {
  OPENAI
  ANTHROPIC
  GEMINI
  DEEPGRAM
}

enum TelephonyProvider {
  TWILIO
  PLIVO
  SUPERPHONE
}

enum VoiceEngine {
  REALTIME
  GEMINI_LIVE
  CASCADED
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GEMINI
}

/// How hard the agent filters the caller's line before its voice detection
/// hears it. STRONG suits noisy places (street, call centre, TV in the room).
enum NoiseFilter {
  OFF
  STANDARD
  STRONG
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  CANCELED
}

/// How a campaign call went for the contact, as far as reaching them goes.
/// SILENT: the line connected but nobody spoke (often a voicemail box).
enum DialResult {
  REACHED
  NO_ANSWER
  BUSY
  VOICEMAIL
  FAILED
  SILENT
}

/// When a campaign calls unanswered numbers again.
/// END_OF_LIST: once everyone on the list has had a call (round by round).
/// AFTER_DELAY: a set time after the missed call, before untried numbers.
/// NEXT_DAY: at the start of the next calling day.
enum RetryStrategy {
  END_OF_LIST
  AFTER_DELAY
  NEXT_DAY
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum ContactStatus {
  PENDING
  CALLING
  COMPLETED
  FAILED
  NO_ANSWER
  DO_NOT_CALL
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  TRANSFERRED
  NO_ANSWER
  BUSY
  FAILED
  CANCELED
}

enum CallOutcome {
  INTERESTED
  NOT_INTERESTED
  APPOINTMENT_BOOKED
  CALLBACK_REQUESTED
  TRANSFERRED
  VOICEMAIL
  WRONG_NUMBER
  DO_NOT_CALL
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum IntegrationType {
  GOOGLE_CALENDAR
  SLACK
  HUBSPOT
  ZAPIER
  CALENDLY
  /// The workspace's own mail server; agents email information during calls.
  SMTP
  /// WhatsApp Business (Meta Cloud API or Twilio); agents send messages during calls.
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  NORMAL
  HIGH
  URGENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  passwordHash    String
  /// Google account id ("sub") once the user has signed in with Google.
  googleId        String?    @unique
  role            Role       @default(SUBSCRIBER)
  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timezone        String     @default("UTC")
  suspended       Boolean    @default(false)
  lastLoginAt     DateTime?
  /// When the user accepted the Terms and Privacy Policy, and which version.
  termsAcceptedAt DateTime?
  termsVersion    String?
  /// Opted in to product news by email (never pre-ticked).
  marketingOptIn  Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions        Session[]
  passwordResets  PasswordReset[]
  ticketMessages  TicketMessage[]
  assignedTickets Ticket[]        @relation("TicketAssignee")
  auditLogs       AuditLog[]
  posts           Post[]
  leads           Lead[]          @relation("LeadOwner")
  media           MediaAsset[]
  placedCalls     Call[]          @relation("PlacedCalls")

  @@index([workspaceId])
  @@index([role])
}

/// One row per refresh token. Rotated on every refresh; reuse of a rotated
/// token revokes the whole family (stolen-token detection).
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── Tenancy & billing ───────────────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  name        String
  timezone    String   @default("UTC")
  suspended   Boolean  @default(false)
  /// The platform's own workspace, where super admins run agents, campaigns
  /// and calls. Never billed; left out of subscriber analytics.
  internal    Boolean  @default(false)
  /// GST registration (India), given at checkout; on Razorpay invoices.
  gstin       String?
  /// Legal business name for invoices.
  billingName String?
  /// Staff-only notes about the customer.
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  subscription       Subscription?
  subscriptionEvents SubscriptionEvent[]
  payments           Payment[]
  usagePeriods       UsagePeriod[]
  credentials        AiCredential[]
  aiSettings         WorkspaceAiSettings?
  telephonyAccounts  TelephonyAccount[]
  phoneNumbers       PhoneNumber[]
  agents             Agent[]
  campaigns          Campaign[]
  contacts           CampaignContact[]
  calls              Call[]
  appointments       Appointment[]
  integrations       Integration[]
  webhookEndpoints   WebhookEndpoint[]
  apiKeys            ApiKey[]
  automations        Automation[]
  tickets            Ticket[]
  auditLogs          AuditLog[]
  messages           CallMessage[]
}

model Plan {
  id                      String   @id @default(cuid())
  code                    PlanCode @unique
  name                    String
  tagline                 String   @default("")
  /// null = custom pricing (Enterprise).
  priceMonthlyCents       Int?
  /// null = custom.
  includedMinutes         Int?
  /// PlanLimits from @pv/shared. null values mean unlimited.
  limits                  Json
  /// PlanFeatures from @pv/shared.
  features                Json
  highlights              String[]
  featured                Boolean  @default(false)
  selfServe               Boolean  @default(true)
  stripePriceId           String?
  /// Razorpay plan (plan_…), billed in INR: UPI Autopay, RuPay and other cards.
  razorpayPlanId          String?
  /// Amount of the Razorpay plan Purple Voice created itself (paise); null
  /// when staff pasted the plan id, which is then used as it is.
  razorpayPlanAmountPaise Int?
  /// Fixed INR price for Razorpay. Empty = the USD price at today's rate.
  priceMonthlyInrPaise    Int?
  /// PayPal billing plan (P-…).
  paypalPlanId            String?
  active                  Boolean  @default(true)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  workspaceId            String             @unique
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus @default(INCOMPLETE)
  provider               BillingProvider    @default(STRIPE)
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  razorpaySubscriptionId String?            @unique
  paypalSubscriptionId   String?            @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  /// Enterprise: negotiated monthly price, counted in MRR.
  customPriceCents       Int?
  /// Enterprise: minutes per period, overrides the plan.
  customMinutes          Int?
  /// Partial PlanLimits overriding the plan for this workspace.
  customLimits           Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
  @@index([planId])
}

/// Append-only history used for churn, upgrade and MRR movement analytics.
model SubscriptionEvent {
  id            String                @id @default(cuid())
  workspaceId   String
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type          SubscriptionEventType
  fromPlan      PlanCode?
  toPlan        PlanCode?
  /// Change in monthly recurring revenue caused by this event, in cents.
  mrrDeltaCents Int                   @default(0)
  note          String?
  occurredAt    DateTime              @default(now())

  @@index([type, occurredAt])
  @@index([workspaceId])
}

model Payment {
  id                String          @id @default(cuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  amountCents       Int
  currency          String          @default("usd")
  status            String
  provider          BillingProvider @default(STRIPE)
  providerInvoiceId String?         @unique
  description       String?
  periodStart       DateTime?
  periodEnd         DateTime?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  @@index([paidAt])
  @@index([workspaceId])
}

/// Call seconds consumed in one billing period. Incremented atomically when a
/// call ends; read on every call start to enforce the plan's minutes.
model UsagePeriod {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  /// Billed minutes (each call rounded up to the minute).
  minutesUsed Int       @default(0)
  callCount   Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, periodStart])
}

// ─── Credentials & telephony ────────────────────────────────────────────────

/// A workspace's own API key for an AI or speech vendor (bring-your-own-key).
/// A subscriber's AI layer, chosen by staff. Workspaces without a row use the
/// platform default (SiteSetting "ai").
model WorkspaceAiSettings {
  workspaceId String      @id
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  voiceEngine VoiceEngine
  /// The LLM vendor for the CASCADED engine; ignored by speech-to-speech engines.
  llmProvider AiProvider  @default(OPENAI)
  /// Realtime / Live model for speech-to-speech engines, the LLM for CASCADED.
  model       String
  updatedById String?
  updatedAt   DateTime    @updatedAt
}

/// Platform-wide AI keys (Super admin → AI providers). Used for every
/// subscriber that has no key of its own for that vendor.
/// A payment gateway's credentials, set by a super admin. Secrets are
/// encrypted; `publicId` (Razorpay key id, PayPal client id) and `webhookId`
/// (PayPal) are not secret.
model PaymentGatewayConfig {
  gateway          PaymentGateway @id
  enabled          Boolean        @default(true)
  /// "test" (sandbox) or "live".
  mode             String         @default("test")
  publicId         String?
  secretEnc        String
  webhookSecretEnc String?
  webhookId        String?
  last4            String
  verifiedAt       DateTime?
  updatedAt        DateTime       @updatedAt
}

model PlatformCredential {
  provider   CredentialProvider @id
  label      String?
  apiKeyEnc  String
  last4      String
  verifiedAt DateTime?
  updatedAt  DateTime           @updatedAt
}

/// A subscriber's own key for one vendor, added by staff. Takes precedence
/// over the platform key.
model AiCredential {
  id          String             @id @default(cuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    CredentialProvider
  label       String?
  apiKeyEnc   String
  last4       String
  verifiedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([workspaceId, provider])
}

model TelephonyAccount {
  id             String            @id @default(cuid())
  workspaceId    String
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider       TelephonyProvider
  label          String?
  /// Encrypted JSON: { accountSid, authToken } | { authId, authToken } | { apiKey, sipDomain }
  credentialsEnc String
  /// Non-secret identifier shown in the UI (Account SID / Auth ID).
  publicId       String
  verifiedAt     DateTime?
  createdAt      DateTime          @default(now())

  phoneNumbers PhoneNumber[]

  @@index([workspaceId])
}

model PhoneNumber {
  id                 String           @id @default(cuid())
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telephonyAccountId String
  telephonyAccount   TelephonyAccount @relation(fields: [telephonyAccountId], references: [id], onDelete: Cascade)
  e164               String
  friendlyName       String?
  /// Provider's id for the number (Twilio PN sid, Plivo number).
  providerNumberId   String?
  /// Provider-side application routing this number (Plivo).
  providerAppId      String?
  inboundAgentId     String?
  inboundAgent       Agent?           @relation("InboundAgent", fields: [inboundAgentId], references: [id], onDelete: SetNull)
  /// Whether our voice URL is currently configured on the provider.
  routingConfigured  Boolean          @default(false)
  routingError       String?
  createdAt          DateTime         @default(now())

  campaigns Campaign[]
  calls     Call[]

  @@unique([workspaceId, e164])
  @@index([e164])
}

// ─── Agents, campaigns, calls ───────────────────────────────────────────────

model Agent {
  id                        String      @id @default(cuid())
  workspaceId               String
  workspace                 Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                      String
  status                    AgentStatus @default(DRAFT)
  /// One of the voices of the workspace's engine; the engine default is used if it no longer fits.
  voice                     String
  language                  String      @default("en-US")
  systemPrompt              String
  greeting                  String      @default("")
  goal                      String      @default("")
  knowledge                 String      @default("")
  transferEnabled           Boolean     @default(false)
  transferNumber            String?
  appointmentBookingEnabled Boolean     @default(false)
  calendarIntegrationId     String?
  appointmentDurationMin    Int         @default(30)
  timezone                  String      @default("UTC")
  maxCallDurationSec        Int         @default(900)
  recordCalls               Boolean     @default(false)
  /// Used instead of the greeting/goal when someone calls one of its numbers.
  inboundGreeting           String      @default("")
  inboundInstructions       String      @default("")
  /// Used when someone this agent called earlier calls back.
  callbackGreeting          String      @default("")
  callbackInstructions      String      @default("")
  noiseFilter               NoiseFilter @default(STANDARD)
  /// Send information by email during a call (Integrations → Email (SMTP)).
  emailEnabled              Boolean     @default(false)
  /// Send information on WhatsApp during a call (Integrations → WhatsApp).
  whatsappEnabled           Boolean     @default(false)
  /// What the agent may send when asked: links, prices, brochure text, address.
  shareInfo                 String      @default("")
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  inboundNumbers PhoneNumber[] @relation("InboundAgent")
  campaigns      Campaign[]
  calls          Call[]
  messages       CallMessage[]

  @@index([workspaceId])
}

model Campaign {
  id                 String         @id @default(cuid())
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  agentId            String
  agent              Agent          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  phoneNumberId      String
  phoneNumber        PhoneNumber    @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)
  goal               String         @default("")
  /// How the agent tailors each call to the contact's details (name, business, CSV columns).
  personalization    String         @default("")
  status             CampaignStatus @default(DRAFT)
  timezone           String         @default("UTC")
  callWindowStart    String         @default("09:00")
  callWindowEnd      String         @default("18:00")
  /// 0 = Sunday … 6 = Saturday.
  callDays           Int[]          @default([1, 2, 3, 4, 5])
  /// Calls per contact in all: the first call plus up to 5 retries.
  maxAttempts        Int            @default(2)
  /// Least time before the same number is called again.
  retryDelayMinutes  Int            @default(240)
  retryStrategy      RetryStrategy  @default(END_OF_LIST)
  /// Which results are worth another call.
  retryOn            DialResult[]   @default([NO_ANSWER, BUSY, VOICEMAIL, SILENT, FAILED])
  /// Optional hours (campaign time zone) for retries only, e.g. evenings.
  retryWindowStart   String?
  retryWindowEnd     String?
  /// When the subscriber confirmed they have consent to call this list.
  consentConfirmedAt DateTime?
  concurrency        Int            @default(1)
  /// Pause before the next call starts, after the last one started or ended.
  callDelaySeconds   Int            @default(20)
  startedAt          DateTime?
  completedAt        DateTime?
  /// The campaign this one follows up on (re-calls, appointment confirmations).
  parentCampaignId   String?
  parentCampaign     Campaign?      @relation("FollowUps", fields: [parentCampaignId], references: [id], onDelete: SetNull)
  followUps          Campaign[]     @relation("FollowUps")
  /// Which groups of the parent's contacts this follow-up was built from.
  followUpSegments   String[]       @default([])
  /// AI analysis of the finished campaign (services/ai/campaign-report.ts).
  aiReport           Json?
  aiReportAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  contacts CampaignContact[]
  calls    Call[]

  @@index([workspaceId])
  @@index([status])
  @@index([parentCampaignId])
}

model CampaignContact {
  id            String        @id @default(cuid())
  campaignId    String
  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phone         String
  name          String?
  email         String?
  company       String?
  notes         String?
  /// Extra CSV columns, available to the agent as {{variables}}.
  fields        Json?
  status        ContactStatus @default(PENDING)
  attempts      Int           @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  lastOutcome   CallOutcome?
  /// Whether the last call reached them, and if not, why.
  lastResult    DialResult?
  /// Labels added by hand or in the CSV ("vip", "webinar"); follow-up campaigns can target them.
  tags          String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  calls Call[]

  @@unique([campaignId, phone])
  @@index([status, nextAttemptAt])
  @@index([workspaceId])
}

model Call {
  id             String            @id @default(cuid())
  workspaceId    String
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  campaignId     String?
  campaign       Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        CampaignContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  phoneNumberId  String?
  phoneNumber    PhoneNumber?      @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  provider       TelephonyProvider
  providerCallId String?
  direction      CallDirection
  fromNumber     String
  toNumber       String
  status         CallStatus        @default(QUEUED)
  startedAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int               @default(0)
  billedMinutes  Int               @default(0)
  /// [{ role: "agent" | "caller" | "system", text, at }]
  transcript     Json              @default("[]")
  summary        String?
  outcome        CallOutcome?
  /// -1 … 1
  sentiment      Float?
  recordingUrl   String?
  transferredTo  String?
  endReason      String?
  errorMessage   String?
  /// A person calling from the browser dialer (no AI agent on the line).
  placedById     String?
  placedBy       User?             @relation("PlacedCalls", fields: [placedById], references: [id], onDelete: SetNull)
  /// An inbound call from someone an agent called earlier.
  isCallback     Boolean           @default(false)
  /// Set when post-call processing (summary, webhooks, usage) has run.
  finalizedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  appointments Appointment[]
  messages     CallMessage[]

  @@unique([provider, providerCallId])
  @@index([workspaceId, createdAt])
  @@index([campaignId])
  @@index([status])
}

model Appointment {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  callId           String?
  call             Call?             @relation(fields: [callId], references: [id], onDelete: SetNull)
  integrationId    String?
  contactName      String
  contactPhone     String
  contactEmail     String?
  startsAt         DateTime
  endsAt           DateTime
  timezone         String            @default("UTC")
  notes            String?
  status           AppointmentStatus @default(SCHEDULED)
  externalEventId  String?
  externalEventUrl String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([workspaceId, startsAt])
}

/// An email or WhatsApp message an agent sent during a call.
model CallMessage {
  id                String         @id @default(cuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  callId            String?
  call              Call?          @relation(fields: [callId], references: [id], onDelete: SetNull)
  agentId           String?
  agent             Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  channel           MessageChannel
  to                String
  subject           String?
  body              String
  /// "sent" or "failed".
  status            String
  error             String?
  providerMessageId String?
  createdAt         DateTime       @default(now())

  @@index([workspaceId, createdAt])
  @@index([callId])
}

// ─── Integrations & developer tools ─────────────────────────────────────────

model Integration {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type         IntegrationType
  /// Encrypted JSON: OAuth tokens or the app's API token / incoming webhook URL.
  secretsEnc   String?
  config       Json?
  accountLabel String?
  connectedAt  DateTime        @default(now())
  lastError    String?

  @@unique([workspaceId, type])
}

model WebhookEndpoint {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  description String?
  events      String[]
  secretEnc   String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         DeliveryStatus  @default(PENDING)
  attempts       Int             @default(0)
  responseStatus Int?
  lastError      String?
  nextAttemptAt  DateTime        @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// First characters, shown in the UI to tell keys apart.
  prefix      String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model Automation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  trigger     String
  conditions  Json      @default("[]")
  actions     Json
  active      Boolean   @default(true)
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, trigger])
}

// ─── Support ────────────────────────────────────────────────────────────────

model Ticket {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject     String
  status      TicketStatus   @default(OPEN)
  /// Pro and Enterprise tickets open as HIGH (priority support).
  priority    TicketPriority @default(NORMAL)
  assigneeId  String?
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages TicketMessage[]

  @@index([status, priority])
  @@index([workspaceId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromStaff Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ─── Website CMS ────────────────────────────────────────────────────────────

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  body           String        @default("")
  /// "markdown" (body) or "builder" (blocks).
  layout         String        @default("markdown")
  /// Page-builder sections (PageBlock[] from @pv/shared), used when layout is "builder".
  blocks         Json          @default("[]")
  status         ContentStatus @default(DRAFT)
  showInFooter   Boolean       @default(false)
  /// Linked from the site header, in navOrder, labelled navLabel (or the title).
  showInHeader   Boolean       @default(false)
  navLabel       String?
  navOrder       Int           @default(0)
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  canonicalUrl   String?
  noindex        Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Post {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  excerpt           String        @default("")
  body              String        @default("")
  coverImageUrl     String?
  tags              String[]
  status            ContentStatus @default(DRAFT)
  authorId          String?
  author            User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  seoTitle          String?
  seoDescription    String?
  ogImageUrl        String?
  noindex           Boolean       @default(false)
  /// Advanced SEO (Admin → Blog → SEO).
  focusKeyword      String?
  secondaryKeywords String[]      @default([])
  canonicalUrl      String?
  ogTitle           String?
  ogDescription     String?
  /// Ask search engines not to follow the post's links.
  nofollow          Boolean       @default(false)
  /// schema.org type: BlogPosting, Article, NewsArticle, TechArticle or HowTo.
  schemaType        String        @default("BlogPosting")
  /// [{ question, answer }]: shown under the post and marked up as FAQPage.
  faq               Json          @default("[]")
  /// HowTo steps: [{ name, text }].
  howToSteps        Json          @default("[]")
  category          String?
  /// Byline shown instead of the staff account's name, with a short bio.
  authorName        String?
  authorBio         String?
  showToc           Boolean       @default(true)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, publishedAt])
}

/// Old URLs that moved, so links and search rankings follow (created when a
/// slug changes, editable in Admin → SEO).
model Redirect {
  id        String    @id @default(cuid())
  fromPath  String    @unique
  toPath    String
  permanent Boolean   @default(true)
  hits      Int       @default(0)
  lastHitAt DateTime?
  createdAt DateTime  @default(now())
}

/// A visitor's cookie choices (GDPR / UK GDPR / PECR accountability). No
/// account, no raw IP: a random id from the browser and a salted IP hash.
model ConsentRecord {
  id            String   @id @default(cuid())
  consentId     String
  analytics     Boolean
  marketing     Boolean
  preferences   Boolean
  /// The browser sent Global Privacy Control (treated as an opt-out of sale/share).
  gpc           Boolean  @default(false)
  policyVersion String
  ipHash        String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([consentId])
  @@index([createdAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Key/value site settings: "seo", "security" (captcha toggles), "analytics".
/// Values are JSON validated by @pv/shared schemas.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

/// CRM: enquiries from the public site (contact sales, enterprise). Staff work
/// them through the statuses above from the admin panel.
model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  plan      PlanCode?
  source    String     @default("contact_form")
  status    LeadStatus @default(NEW)
  notes     String     @default("")
  ownerId   String?
  owner     User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

/// Uploaded images. Every upload is converted to WebP at its original
/// resolution and stored once: `sourceHash` (the uploaded bytes) and
/// `contentHash` (the WebP output) are both unique, so uploading the same
/// image again returns the existing asset instead of a copy.
model MediaAsset {
  id           String   @id @default(cuid())
  /// Logical folder, one per page or post: "pages/home", "blog/my-post", "brand".
  folder       String
  filename     String
  storageKey   String   @unique
  url          String
  mimeType     String   @default("image/webp")
  width        Int
  height       Int
  sizeBytes    Int
  originalName String
  originalSize Int
  sourceHash   String   @unique
  contentHash  String   @unique
  alt          String   @default("")
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([folder, createdAt])
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id          String     @id @default(cuid())
  actorId     String?
  actor       User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  action      String
  entity      String?
  entityId    String?
  meta        Json?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
}
