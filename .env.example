# ════════════════════════════════════════════════════════════════════════════
#  Purple Voice — environment configuration template
#
#  Copy the API block to apps/api/.env and the Web block to apps/web/.env.local
#  for local development. In production they live in /etc/purple-voice/api.env
#  and /etc/purple-voice/web.env (see DEPLOYMENT.md). Never commit a real .env.
#
#  Generate secrets with:   openssl rand -base64 48
#  Generate the 32-byte encryption key with:   openssl rand -base64 32
# ════════════════════════════════════════════════════════════════════════════


# ────────────────────────────────────────────────────────────────────────────
#  API  (apps/api/.env)
# ────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Local: `docker compose up -d db` starts Postgres 16 on port 5434.
DATABASE_URL=postgresql://pv:pv_dev_password@localhost:5434/purple_voice?schema=public

# ── URLs ────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4000
# Public origin of the website.
APP_URL=http://localhost:3000
# Public origin carriers (Twilio/Plivo) call back to. In production this is the
# same as APP_URL (nginx routes /api and /ws to the API). Locally, point it at a
# tunnel such as https://<id>.ngrok-free.app so carriers can reach your laptop.
PUBLIC_API_URL=
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000
# ── Revalidation ────────────────────────────────────────────────────────────
# After CMS edits the API calls the web app's /internal/revalidate so public
# pages refresh within seconds while staying statically served.
WEB_INTERNAL_URL=http://127.0.0.1:3000
# Shared secret; must match REVALIDATE_SECRET in the Web block.
REVALIDATE_SECRET=change-me-revalidate-secret

# ── Authentication ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Set only when the site and API share a parent domain across subdomains.
COOKIE_DOMAIN=

# ── Encryption & signing ────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts AI keys, carrier tokens and OAuth tokens at rest.
# Changing it makes existing stored secrets unreadable — back it up with the database.
APP_ENCRYPTION_KEY=change-me-with-openssl-rand-base64-32-xxxxxxxx=
# Signs the callback and media-stream URLs handed to carriers.
URL_SIGNING_SECRET=change-me-url-signing-secret-at-least-32-characters

# ── Storage (uploaded media) ────────────────────────────────────────────────
# local: files under STORAGE_LOCAL_PATH, served by nginx at /uploads
# s3:    any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=../../storage/uploads
# Public URL prefix for stored files. Defaults to APP_URL/uploads.
STORAGE_PUBLIC_URL=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Uploads are converted to WebP at full resolution.
MEDIA_MAX_UPLOAD_MB=10
MEDIA_WEBP_QUALITY=90

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Unset SMTP_HOST logs emails to the console instead of sending them.
# Local: `docker compose up -d mailpit` and use SMTP_HOST=localhost SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Purple Voice <no-reply@purplevoice.ai>"
# Staff inboxes notified about new tickets and website leads (comma separated).
SUPPORT_NOTIFY_EMAILS=

# ── Billing (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly recurring price ids for the self-serve plans ($19 Basic, $299 Pro).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
# Development only: with no Stripe key, "choose a plan" activates it instantly.
# Ignored when NODE_ENV=production.
BILLING_DEV_BYPASS=true

# ── Captcha (public forms) ──────────────────────────────────────────────────
# none | turnstile | recaptcha | hcaptcha. Which forms use it is toggled in
# Admin → Security. The matching site key goes in the Web block below.
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=
# reCAPTCHA v3 only: minimum score to accept.
CAPTCHA_MIN_SCORE=0.5

# ── Google Calendar (appointment booking) ───────────────────────────────────
# OAuth client (Web application). Authorised redirect URI:
#   <PUBLIC_API_URL or APP_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Platform AI (support assistant, SEO drafts) ─────────────────────────────
# The platform's own Claude key. Subscriber calls use their own keys instead.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# ── Seeding ─────────────────────────────────────────────────────────────────
SEED_SUPER_ADMIN_EMAIL=admin@purplevoice.local
SEED_SUPER_ADMIN_PASSWORD=
# Seed a demo Pro workspace with sample calls (never in production).
SEED_DEMO=true

# ── Workers & logging ───────────────────────────────────────────────────────
DIALER_INTERVAL_MS=5000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info


# ────────────────────────────────────────────────────────────────────────────
#  Web  (apps/web/.env.local)
# ────────────────────────────────────────────────────────────────────────────

# Canonical public URL: used for sitemaps, canonical links and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the web server reaches the API (server-side rendering, dev rewrites).
API_INTERNAL_URL=http://127.0.0.1:4000
# Must match the API's REVALIDATE_SECRET.
REVALIDATE_SECRET=change-me-revalidate-secret
# Public site key for the provider in CAPTCHA_PROVIDER.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
